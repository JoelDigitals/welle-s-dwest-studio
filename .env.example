# Kostenloser API-Key aus https://aistudio.google.com/apikey
# Nötig für Moderationstexte/Nachrichten. Für die Sprachausgabe optional – ohne Key
# (oder bei Überlastung) springt automatisch der kostenlose Edge-TTS-Fallback ein.
GEMINI_API_KEY=

# Optional, aber empfohlen: kostenloser Fallback, falls Gemini überlastet ist
# oder das Freikontingent ausgeschöpft. Key unter https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Modelle überschreiben, falls Google/Groq ein Modell abkündigt.
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
